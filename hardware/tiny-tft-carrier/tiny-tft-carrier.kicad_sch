	(text "Pin map (XIAO pin = ESP32-S3 GPIO / ESP32-C6 GPIO):\nSCLK = D8 = GPIO7 / GPIO19\nSDIN = D10 = GPIO9 / GPIO18\nDC = D3 = GPIO4 / GPIO21\nRES = D4 = GPIO5 / GPIO22\nCS = D5 = GPIO6 / GPIO23\nBL = D1 = GPIO2 / GPIO1, only when JP1 is bridged\nUnused on purpose: D0, D2 (S3 strapping GPIO3), D6/D7 (UART0), D9, 5V" (exclude_from_sim no) (at 30.48 129.54 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3592eb62-9363-5934-9a31-e37c3f2537fe"))
	(text "JP1 open (as made): the screen keeps BL pulled high, backlight always on.\nBridge JP1 to switch the backlight from D1 (high = on)." (exclude_from_sim no) (at 129.54 50.8 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d6aa85ea-0d35-5d0e-ab6f-73847ba209d5"))
	(text "Screen breakout: two rows of four pins, 2.54 mm pitch.\nRow spacing 15.24 mm and outline about 12.9 x 20.8 mm are photo estimates: TO MEASURE.\nFit the screen face up, flex cable at the end away from the XIAO." (exclude_from_sim no) (at 129.54 129.54 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "2f0d0279-0423-547b-84f0-79293aba9041"))
	(sheet_instances (path "/" (page "1")))
)
