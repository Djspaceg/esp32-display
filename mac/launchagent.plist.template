<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.resourcefork.espdisplay</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/open</string>
		<string>-gj</string>
		<string>__APP__</string>
		<string>--args</string>
		<string>--background</string>
	</array>
	<!-- LaunchServices owns the app process without activating it. The app
	     receives the background argument after identification. -->
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/tmp/espdisplaysender.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/espdisplaysender.log</string>
</dict>
</plist>
