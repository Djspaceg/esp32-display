<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.espdisplay.sender</string>
	<key>ProgramArguments</key>
	<array>
		<string>__BIN__</string>
		<string>--background</string>
		<string>--fps</string>
		<string>40</string>
	</array>
	<!-- Start at login... -->
	<key>RunAtLoad</key>
	<true/>
	<!-- Restart after crashes or startup failures, but not after a clean Quit.
	     launchd throttles abnormal respawns, and the sender's single-instance
	     lock makes a manual double-click coexist safely. -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<!-- Marks abnormal agent respawns so a lock collision exits quietly;
	     a foreground launch instead asks the primary process to show its
	     manager window. -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>ESPDISP_AGENT</key>
		<string>1</string>
	</dict>
	<key>StandardOutPath</key>
	<string>/tmp/espdisplaysender.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/espdisplaysender.log</string>
</dict>
</plist>
