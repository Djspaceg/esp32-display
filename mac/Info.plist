<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>ESPDisplaySender</string>
	<key>CFBundleIdentifier</key>
	<string>com.espdisplay.sender</string>
	<key>CFBundleIconFile</key>
	<string>app-icon-square.png</string>
	<key>CFBundleName</key>
	<string>ESPDisplaySender</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.1</string>
	<!-- Taken from the build setting, which mac/make-app.sh derives from the
	     commit count so it always moves when the source does. Hardcoding it here
	     is what pinned every build at 2 and made a fresh app indistinguishable
	     from a two-week-old one. The marketing version above stays a literal:
	     that one is the user's to choose. -->
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSAppleScriptEnabled</key>
	<true/>
	<key>OSAScriptingDefinition</key>
	<string>ESPDisplaySender.sdef</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_espdisp._udp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>ESPDisplaySender discovers and streams to display panels on your local network.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>ESPDisplaySender sends audio from your selected microphone to the display panel.</string>
	<!-- Background by default; the manager opts into Dock/menu presence only while visible. -->
	<key>LSUIElement</key>
	<true/>
</dict>
</plist>
