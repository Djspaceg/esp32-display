{
  // One-click entries for this repo's mac/ scripts, rendered in the Commands
  // view by the usernamehw.commands extension. Icon color encodes blast radius:
  // green reads state or is idempotent, yellow changes local state, red would be
  // destructive. Nothing here is red, so no entry needs a typed confirmation.
  "commands.workspaceCommands": {
    "Build and restart sender": {
      "command": "commands.runInTerminal",
      "args": {
        "text": "\"${workspaceFolder}/mac/build-and-restart.command\"",
        "name": "sender",
        "reveal": true,
        "reuse": "newest"
      },
      "icon": "rocket",
      "iconColor": "terminal.ansiGreen",
      "markdownTooltip": "The usual after changing sender code. Stops the running sender, rebuilds `ESPDisplaySender.app` in Release via Xcode, reinstalls the LaunchAgent, then reports whether it came back up.\n\nTakes about a minute. The outgoing install is moved to the Trash rather than deleted, so repeated runs accumulate bundles there. Ends by waiting for a return keypress.",
      "statusBar": {
        "text": "Build and restart sender",
        "hidden": true
      }
    },
    "Stop sender": {
      "command": "commands.runInTerminal",
      "args": {
        "text": "\"${workspaceFolder}/mac/stop-sender.command\"",
        "name": "sender",
        "reveal": true,
        "reuse": "newest"
      },
      "icon": "debug-stop",
      "iconColor": "terminal.ansiYellow",
      "markdownTooltip": "Unloads the `com.espdisplay.sender` LaunchAgent, which frees `/tmp/espdisplaysender.lock` and stops streaming.\n\nRun this before pressing Run in Xcode. Otherwise the freshly built binary cannot take the lock, asks the installed copy to show its window, and exits — which looks like a successful launch but is not. Idempotent. Ends by waiting for a return keypress."
    },
    "Build app to ~/Applications": {
      "command": "commands.runInTerminal",
      "args": {
        "text": "\"${workspaceFolder}/mac/make-app.sh\"",
        "name": "make-app",
        "reveal": true,
        "reuse": "newest"
      },
      "icon": "package",
      "iconColor": "terminal.ansiYellow",
      "markdownTooltip": "Xcode Release build of the `ESPDisplaySender App` scheme, installed to `~/Applications/ESPDisplaySender.app`. Signed with the project's Apple Development team so its designated requirement survives rebuilds and macOS keeps existing Screen Recording and Local Network grants.\n\nAny previous install is moved to the Trash. Builds and installs only — it does not start anything, and it does not touch a running agent, so prefer **Build and restart sender** for the normal loop."
    },
    "Install login agent": {
      "command": "commands.runInTerminal",
      "args": {
        "text": "\"${workspaceFolder}/mac/install-launch-agent.sh\"",
        "name": "make-app",
        "reveal": true,
        "reuse": "newest"
      },
      "icon": "plug",
      "iconColor": "terminal.ansiYellow",
      "markdownTooltip": "Writes `~/Library/LaunchAgents/com.espdisplay.sender.plist` and bootstraps it, so the sender starts hidden at login and is restarted after abnormal exits. Replaces any existing registration.\n\nRequires the app bundle to exist already — run **Build app to ~/Applications** first, or just use **Build and restart sender**, which does both. Logs land in `/tmp/espdisplaysender.log`."
    }
  }
}
